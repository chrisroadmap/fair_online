{% extends 'site.html.j2' %}
{%- block css %}
    <!-- local style: -->
    <link rel="stylesheet"
          type="text/css"
          href="{{ url_for('static', filename='css/model.css') }}"
          media="all">
{%- endblock %}
{%- block js %}
    <!-- plotly plotting: -->
    <script src="https://cdn.plot.ly/plotly-basic-2.16.1.min.js"
            charset="utf-8">
    </script>
    <!-- page set up / functions: -->
    <script src="{{ url_for('static', filename='js/model.js') }}"
            charset="utf-8"
            defer>
    </script>
{%- endblock %}
{%- block header_img %}
        {% if current_page is defined and header_img is sameas true -%}
        <div id="content_header"
             class="content_header">
          <img src="{{ url_for('static', filename='img/banner/{0}.jpg'.format(current_page)) }}"
               class="content_header_img"
               alt=""
               title="">
          <div id="content_header_image_text"
               class="content_header_image_text flex_row flex_end">
            image credit
          </div>
        </div>
        {%- endif -%}
{%- endblock %}
{%- block content %}
        <div class="flex_row_wrap flex_no_grow">
          <div class="content_overview_heading">
            Model
          </div>
        </div>
        <div id="content_overview"
             class="flex_row_wrap flex_justify flex_no_grow">
          <div class="content_text flex_column">
            <p>
              Some information goes here ...
            </p>
          </div>
        </div>
        <div class="content_text flex_column flex_no_grow">
          <h4>Input parameters</h4>
        </div>
        <div id="content_model_inputs"
             class="content_model_inputs flex_column flex_no_grow">
          <div id="scenarios_input_label"
               class="content_model_input flex_row_wrap">
            <label id="scenarios_input_label_text"
                   class="input_label"
                   hover-text="Model scenarios">
              Model scenarios
            </label>
          </div>
          <div id="scenarios_input"
               class="content_model_input flex_row_wrap">
            {%- for scenario in scenarios %}
            <label id="scenarios_input_{{ scenario['name'] }}_label"
                   class="scenarios_input_label">
              <input id="scenarios_input_{{ scenario['name'] }}_checkbox"
                     class="scenarios_input_checkbox"
                     type="checkbox"
                     {%- if scenario['checked'] == true %}
                     checked
                     {%- endif %}
                     name="scenarios_{{ scenario['name'] }}"
                     value="{{ scenario['name'] }}">
              <span id="scenarios_input_{{ scenario['name'] }}_label_text"
                    class="scenarios_input_label_text">
                {{ scenario['name'] }}
              </span>
            </label>
            {%- endfor %}
          </div>
          <div id="scenarios_input_error"
               class="input_error">
          </div>
          <div id="species_input_label"
               class="content_model_input flex_row_wrap">
            <label id="species_input_label_text"
                   class="input_label"
                   hover-text="Species">
              Species
            </label>
          </div>
          <div id="species_input"
               class="content_model_input flex_row_wrap">
            {%- for specie in species %}
            <label id="species_input_{{ specie }}_label"
                   class="species_input_label">
              <input id="species_input_{{ specie }}_checkbox"
                     class="species_input_checkbox"
                     type="checkbox"
                     {%- if specie in default_species %}
                     checked
                     {%- endif %}
                     name="species"
                     value="{{ specie }}">
              <span id="species_input_{{ specie }}_label_text"
                    class="species_input_label_text">
                {{ specie }}
              </span>
            </label>
            {%- endfor %}
          </div>
          <div id="species_input_error"
               class="input_error">
          </div>
          <div id="run_model"
                class="content_input flex_row">
            <button id="run_model_button"
                    class="run_button">
              run model
            </button>
            <img id="content_model_spinner"
                 class="content_model_spinner"
                 src="{{ url_for('static', filename='img/home/spinner.gif') }}">
          </div>
        </div>
        <div id="content_plots">
          <div class="content_text flex_column">
            <h4>Plots</h4>
          </div>
          <div id="content_ts_plots"
               class="content_plots flex_row_wrap flex_justify
                      flex_grow">
          </div>
        </div>
{%- endblock %}
